{
  "version": 2,
  "builds": [
    {
      "src": "ticket-booking-app/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "ticket-booking-app/public/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ticket-booking-app/api/index.js"
    }
  ]
}
